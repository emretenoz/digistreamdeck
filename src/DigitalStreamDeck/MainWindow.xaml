<Window x:Class="DigitalStreamDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Digital Stream Deck" Width="450" Height="356" Style="{StaticResource {x:Type Window}}"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" WindowStartupLocation="Manual"
        SourceInitialized="Window_SourceInitialized" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="18">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /><RowDefinition Height="30" /></Grid.RowDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="STREAM DECK" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Alt + Mouse Button 4 · Göster / gizle" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Content="×" Width="32" Height="32" Padding="0" FontSize="23" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="Close_Click" ToolTip="Uygulamadan çık" AutomationProperties.Name="Uygulamadan çık" />
            </Grid>
            <ItemsControl x:Name="Tiles" Grid.Row="1">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="2" Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="4" Padding="8" Background="{Binding Color, FallbackValue=#2563EB}" BorderBrush="#50FFFFFF"
                                Click="Tile_Click" PreviewMouseRightButtonUp="Tile_RightClick" PreviewKeyDown="Tile_PreviewKeyDown"
                                ToolTip="Sol tık: aç · Sağ tık: düzenle" AutomationProperties.Name="{Binding Title}">
                            <StackPanel>
                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" FontSize="30" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="100" />
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Margin="0,9,0,0" TextTrimming="CharacterEllipsis" MaxWidth="100" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Row="2" Text="Sağ tık ile düzenle · Esc ile gizle" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
        </Grid>
    </Border>
</Window>
